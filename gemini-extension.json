{
  "name": "wf-agents",
  "version": "2.0.0",
  "description": "开源复用与工程组装工作流插件（24 工具零依赖 Stdio MCP、6 步人机闸口、策略评估与安全回滚）。",
  "contextFileName": "rules/AGENTS.md",
  "mcpServers": {
    "wf-agents": {
      "command": "python",
      "args": ["${extensionPath}/wf-mode/tools/wf_mcp.py"],
      "env": {
        "WF_ROOT": "${extensionPath}/wf-mode"
      }
    }
  }
}
