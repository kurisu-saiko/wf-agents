{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wf.local/schemas/pipeline.schema.json",
  "title": "管线工序单",
  "description": "管线 manifest 只声明执行所需的最小事实：用哪些槽、至少几个工具、过哪些 gates、产出哪些账本文件。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "mode", "minTools", "slots", "gates", "outputs"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "minTools": { "type": "integer", "minimum": 1 },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "actions"],
        "properties": {
          "slot": { "type": "string", "minLength": 1 },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "required": { "type": "boolean" }
        }
      }
    },
    "promptBlocks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["run.json", "evidence.json", "result.md"] }
    }
  }
}
