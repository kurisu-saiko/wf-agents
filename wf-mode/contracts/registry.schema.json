{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wf.local/schemas/registry.schema.json",
  "title": "能力槽电话簿",
  "description": "registry.yaml 只声明“哪个槽由谁负责、主备是谁、当前状态如何”，不写 provider 实现细节。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slots"],
  "properties": {
    "slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "actions", "primary", "alternate", "status", "license", "os", "credentials", "fallback"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "primary": { "type": "string", "minLength": 1 },
        "alternate": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": ["pending", "measured", "active", "degraded", "disabled"]
        },
        "license": { "type": "string", "minLength": 1 },
        "os": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["windows", "linux", "macos"] }
        },
        "credentials": {
          "type": "array",
          "items": { "type": "string" }
        },
        "fallback": {
          "type": "array",
          "items": { "type": "string" }
        },
        "calibratedAt": { "type": "string" },
        "invalidation": { "type": "string" }
      }
    }
  }
}
