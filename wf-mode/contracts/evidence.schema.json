{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wf.local/schemas/evidence.schema.json",
  "title": "证据账本",
  "description": "结论性内容，不存原始网页。每条命题必须能回溯到来源；verified 必须有来源与原文片段，conflict 至少两个来源。",
  "type": "object",
  "additionalProperties": false,
  "required": ["pipeline", "items", "limitations", "gaps"],
  "properties": {
    "pipeline": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/item" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "gaps": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "sources", "note"],
      "properties": {
        "id": { "type": "string", "pattern": "^E[0-9]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["verified", "unverified", "conflict", "blocked"]
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/source" }
        },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": { "properties": { "sources": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "const": "conflict" } }, "required": ["status"] },
          "then": { "properties": { "sources": { "minItems": 2 } } }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "path", "quote", "date", "tier"],
      "properties": {
        "url": { "type": "string" },
        "path": { "type": "string" },
        "quote": { "type": "string", "maxLength": 500 },
        "date": { "type": "string" },
        "tier": { "type": "string", "enum": ["primary", "secondary"] }
      }
    }
  }
}
