{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wf.local/schemas/adapter-manifest.schema.json",
  "title": "适配器清单",
  "description": "每个能力槽适配器必须声明自己的身份、许可、OS、动作、provider 与凭据需求。",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot", "version", "license", "os", "actions", "providers", "credentials", "writeSurface"],
  "properties": {
    "slot": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "os": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["windows", "linux", "macos"] }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "providers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "env"],
        "properties": {
          "role": { "type": "string", "enum": ["primary", "alternate"] },
          "env": {
            "type": "array",
            "items": { "type": "string" }
          },
          "endpoint": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "credentials": {
      "type": "array",
      "items": { "type": "string" }
    },
    "writeSurface": {
      "type": "array",
      "description": "适配器允许写入的路径；只读适配器为空数组。",
      "items": { "type": "string" }
    },
    "timeoutMs": { "type": "integer", "minimum": 1000 },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": { "type": "integer", "minimum": 0 },
        "backoffMs": { "type": "integer", "minimum": 0 }
      }
    },
    "notes": { "type": "string" }
  }
}
