{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wf.local/schemas/tool-envelope.schema.json",
  "title": "wf-tool 统一信封",
  "description": "所有适配器和能力槽返回给调用方的唯一外层结构。管线只依赖这个结构，不依赖具体 provider。",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "capability", "action", "provider", "data", "error", "degradation", "meta"],
  "properties": {
    "ok": {
      "type": "boolean",
      "description": "动作是否成功。false 时 error 必须非空。"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "description": "能力名称，例如 web_search、web_extract、project_search、repo_ingest。"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "description": "能力动作，例如 search、extract、lookup、ingest、scan。"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "description": "实际执行的适配器或 provider；失败时为最后尝试的 provider。"
    },
    "data": {
      "description": "成功时的归一化数据。"
    },
    "error": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "AUTH_MISSING",
                "AUTH_FAILED",
                "INVALID_INPUT",
                "UNKNOWN_SLOT",
                "UNKNOWN_CAPABILITY",
                "UNKNOWN_PROVIDER",
                "UNKNOWN_ACTION",
                "CAPABILITY_DISABLED",
                "CAPABILITY_PENDING",
                "TOOL_MISSING",
                "TIMEOUT",
                "RATE_LIMIT",
                "UPSTREAM_ERROR",
                "FALLBACK_EXHAUSTED",
                "NOT_IMPLEMENTED",
                "GATE_REJECTED",
                "GATE_REQUIRED",
                "LEDGER_INVALID",
                "INTERNAL"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "details": { "type": "object" }
          }
        }
      ]
    },
    "degradation": {
      "type": "array",
      "description": "主备切换记录；没有降级时为空数组。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "from", "to", "reason"],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ms"],
      "properties": {
        "ms": { "type": "number", "minimum": 0 },
        "runId": { "type": "string" },
        "checkedAt": { "type": "string" },
        "cached": { "type": "boolean" }
      }
    },
    "decision_brief": {
      "type": "object",
      "description": "决策导向摘要（反失控铁律 2：是否命中需求、证据能否核验、局限与代价、可选动作）。",
      "properties": {
        "requirement_fit": { "type": "string" },
        "verifiable_evidence": { "type": "array", "items": { "type": "string" } },
        "limitations_and_tradeoffs": { "type": "array", "items": { "type": "string" } },
        "actionable_options": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "properties": { "error": { "type": "object" } } }
    },
    {
      "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
      "then": { "properties": { "error": { "type": "null" } } }
    }
  ]
}
